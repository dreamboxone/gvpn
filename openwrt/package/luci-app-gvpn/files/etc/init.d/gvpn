#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	/usr/libexec/gvpn/transparent stop >/dev/null 2>&1 || true
	if ! /usr/libexec/gvpn/configure; then
		logger -t gvpn "configuration is invalid; service was not started"
		return 1
	fi
	if ! /usr/libexec/gvpn/transparent start; then
		logger -t gvpn "transparent proxy setup failed; service was not started"
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/gvpn --config /var/run/gvpn/config.toml
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/gvpn
	procd_set_param env XDG_CONFIG_HOME=/etc/gvpn/data
	procd_set_param limits nofile="16384 16384"
	procd_close_instance

	if [ "$(uci -q get gvpn.main.lan_proxy_enabled || echo 0)" = 1 ]; then
		procd_open_instance transparent
		procd_set_param command /usr/bin/sing-box run -c /var/run/gvpn/sing-box.json
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param file /etc/config/gvpn
		procd_close_instance
	fi
}

stop_service() {
	/usr/libexec/gvpn/transparent stop || logger -t gvpn "transparent proxy cleanup reported an error"
}

reload_service() {
	stop
	start
}
